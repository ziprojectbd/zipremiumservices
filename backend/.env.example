# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in values

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Redis (for BullMQ queues and caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# JWT — Use strong random secrets (run: openssl rand -hex 64)
JWT_SECRET=your-strong-random-jwt-secret
JWT_REFRESH_SECRET=your-strong-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CaptchaMaster reseller API key is stored in admin settings (MongoDB), not in env vars.

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ZI Pay payment gateway backend URL (server-to-server payment-result resolution)
# Dev: http://localhost:3001. Production: https://pay.zipremiumservices.com
ZIPAY_URL=http://localhost:3001

# OneServiceBD
ONESERVICEBD_API_KEY=your-oneservicebd-api-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Client URL (for CORS)
CLIENT_URL=https://your-frontend-domain.com

# Additional CORS origins (comma-separated, optional)
CORS_ORIGINS=

# Compression
COMPRESSION_LEVEL=6

# Request Timeout (ms)
REQUEST_TIMEOUT_MS=30000

