{
  "name": "zi-premium-services-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "_moduleAliases": {
    "@": "dist",
    "@controllers": "dist/controllers",
    "@services": "dist/services",
    "@models": "dist/models",
    "@routes": "dist/routes",
    "@middlewares": "dist/middleware",
    "@utils": "dist/utils",
    "@config": "dist/config",
    "@types": "dist/types",
    "@interfaces": "dist/interfaces",
    "@docs": "dist/docs",
    "@jobs": "dist/jobs",
    "@repositories": "dist/repositories",
    "@socket": "dist/socket"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node -r module-alias/register dist/server.js",
    "build": "tsc && tsc-alias -f -fe .js",
    "type-check": "tsc --noEmit",
    "postinstall": "npm rebuild bcryptjs --build-from-source 2>/dev/null || true"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-slow-down": "^2.0.3",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
